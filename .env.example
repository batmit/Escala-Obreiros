# Não colocar valores reais neste arquivo. A aplicação lê variáveis do ambiente,
# não carrega .env automaticamente.
DATABASE_URL=postgresql://APP_USER:PASSWORD@HOST-pooler.neon.tech/DB?sslmode=require
GENERATION_MODE=on-access
HOST=127.0.0.1
PORT=8000
# Apenas para comandos administrativos locais, fora do serviço público:
DATABASE_MIGRATION_URL=postgresql://ADMIN_USER:PASSWORD@HOST.neon.tech/DB?sslmode=require
